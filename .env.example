# Runtime environment: development, test, or production.
JOBFIT_APP_ENV=development

# LLM configuration. Leave secrets empty in this example.
JOBFIT_LLM_PROVIDER=openai
JOBFIT_LLM_MODEL=
JOBFIT_LLM_API_KEY=
JOBFIT_LLM_BASE_URL=
JOBFIT_LLM_TIMEOUT_SECONDS=60
JOBFIT_LLM_MAX_RETRIES=2

# Input limits from the architecture specification.
JOBFIT_MAX_UPLOAD_MB=10
JOBFIT_MAX_RESUME_CHARS=50000
JOBFIT_MAX_JD_CHARS=30000

# Logging and offline demonstration.
JOBFIT_LOG_LEVEL=INFO
JOBFIT_DEMO_MODE=false

# Optional v1.1 job-knowledge settings. No database file is created on import.
JOBFIT_KNOWLEDGE_ENABLED=true
JOBFIT_KNOWLEDGE_VERSION=2026.08.1
JOBFIT_KNOWLEDGE_DB_PATH=
JOBFIT_KNOWLEDGE_SEARCH_MODE=auto
JOBFIT_KNOWLEDGE_REQUIREMENT_LIMIT=12
JOBFIT_KNOWLEDGE_PROMPT_CHAR_LIMIT=8000
JOBFIT_KNOWLEDGE_RETRIEVAL_STRATEGY_VERSION=1.0

# Optional v2 analysis-history database. Empty uses the OS application-data directory.
JOBFIT_ANALYSIS_DB_PATH=
